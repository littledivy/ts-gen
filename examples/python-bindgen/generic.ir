  pyproxy(id: u32, flags: u32, cx: Any?): Any;
  pyInfo(p: Any): (u32, str);
  pyDestroy(p: Any, message: str);
  export { Thrown, PyProxy, get, set, getIndex, has, length, keys, call, invoke, construct, traits, same, iterator, typeOf, instanceOf, toBytes, writeBytes, global, newArray, newObject, box, failure, settle, importModule, later, callback, thrown, pyproxy, pyInfo, pyDestroy };
}

